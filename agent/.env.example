# ---- Nuvem (Sistema de Portaria na Vercel) ----
NUVEM_URL=https://seu-projeto.vercel.app
# Mesmo valor de AGENTE_TOKEN configurado na Vercel
AGENTE_TOKEN=troque-por-um-token-aleatorio-longo
# Identificador do dispositivo cadastrado em Configurações > Dispositivos
DISPOSITIVO_ID=portaria-01

# INTELBRAS_BIOT (equipamento real) ou SIMULADOR (sem equipamento)
MODO=INTELBRAS_BIOT

# ---- Servidor local que o equipamento chama (Modo Online) ----
PORTA_HTTP=3080
CAMINHO_EVENTOS=/notification
# Tempo máximo para a nuvem decidir; mantenha abaixo do timeout configurado no equipamento
TIMEOUT_NUVEM_MS=1500
# Em falha de comunicação: false = nega (seguro), true = libera
LIBERAR_EM_FALHA=false

# ---- Equipamento Intelbras (rede local) ----
EQUIP_HOST=192.168.1.201
EQUIP_PORTA=80
EQUIP_HTTPS=false
EQUIP_USUARIO=admin
EQUIP_SENHA=senha-do-equipamento
EQUIP_CANAL_PORTA=1

# Intervalos (ms)
INTERVALO_FILA_MS=2000
INTERVALO_HEARTBEAT_MS=30000
