# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=chave-anon-publica
# Somente no servidor (Vercel → Environment Variables). Nunca expor no navegador.
SUPABASE_SERVICE_ROLE_KEY=chave-service-role
# Token compartilhado com o agente local (gere um valor aleatório longo)
AGENTE_TOKEN=troque-por-um-token-aleatorio
